# Production Backend API URL (e.g., https://instalife-v2-backend.vercel.app)
VITE_API_URL=https://instalife-v2-backend.vercel.app

# Production Socket Server URL (optional if same as VITE_API_URL)
VITE_SOCKET_URL=https://instalife-v2-backend.vercel.app

# ImageKit Configuration (optional if needed)
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
